# SIMADA - template lintas platform
# Salin konfigurasi yang sesuai:
#   Windows/XAMPP : lihat .env.windows.example
#   Ubuntu Server : lihat .env.ubuntu.example

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/simada
APP_TIMEZONE=Asia/Makassar

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simada
DB_USERNAME=root
DB_PASSWORD=
APP_MASTER_KEY=GANTI_DENGAN_KEY_RANDOM_YANG_TETAP

# Windows dapat memakai storage_simada; Ubuntu production disarankan /srv/documents
SIMADA_STORAGE_PATH=storage_simada
SIMADA_MAX_UPLOAD_MB=20

# Kosongkan executable path jika program sudah dapat ditemukan otomatis oleh OS.
PDFTOTEXT_PATH=
PDFTOPPM_PATH=
TESSERACT_PATH=
TESSERACT_LANG=ind+eng
OCR_MAX_PAGES=30
OCR_DPI=200
LIBREOFFICE_PATH=
