# SIMADA - Windows/XAMPP
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/simada
APP_TIMEZONE=Asia/Makassar

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simada
DB_USERNAME=root
DB_PASSWORD=

# Isi random key minimal 32 karakter dan JANGAN diganti setelah dokumen terenkripsi.
APP_MASTER_KEY=GANTI_DENGAN_RANDOM_KEY_MINIMAL_32_KARAKTER

# Relative path untuk XAMPP Windows
SIMADA_STORAGE_PATH=storage_simada
SIMADA_MAX_UPLOAD_MB=20

# Smart OCR PDF (opsional tetapi direkomendasikan di Windows/XAMPP)
# Kosongkan path jika executable sudah terdaftar di PATH Windows.
PDFTOTEXT_PATH=
PDFTOPPM_PATH=
TESSERACT_PATH=
TESSERACT_LANG=ind+eng
OCR_MAX_PAGES=30
OCR_DPI=200

# Preview Word/Excel. Kosongkan bila LibreOffice terdeteksi otomatis.
LIBREOFFICE_PATH=
