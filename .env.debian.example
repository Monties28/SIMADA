# SIMADA production environment - Linux (Ubuntu Server 24.04 / Debian compatible)
# Untuk target utama Ubuntu, gunakan juga .env.ubuntu.example
APP_ENV=production
APP_DEBUG=false
APP_URL=http://IP-SERVER-ANDA
APP_TIMEZONE=Asia/Makassar

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simada
DB_USERNAME=simada_user
DB_PASSWORD=GANTI_PASSWORD_DATABASE_INI

APP_MASTER_KEY=GANTI_DENGAN_RANDOM_KEY_MINIMAL_32_KARAKTER
SIMADA_STORAGE_PATH=/srv/documents
SIMADA_MAX_UPLOAD_MB=20

PDFTOTEXT_PATH=/usr/bin/pdftotext
PDFTOPPM_PATH=/usr/bin/pdftoppm
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANG=ind+eng
OCR_MAX_PAGES=30
OCR_DPI=200
LIBREOFFICE_PATH=/usr/bin/libreoffice
