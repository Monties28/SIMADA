# SIMADA - Ubuntu Server 24.04 LTS / production
APP_ENV=production
APP_DEBUG=false
APP_URL=http://192.168.1.10
APP_TIMEZONE=Asia/Makassar

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simada
DB_USERNAME=simada_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_KUAT

# PENTING: saat migrasi dari server lama, gunakan APP_MASTER_KEY yang sama.
# Untuk instalasi baru buat key random panjang dan simpan dengan aman.
APP_MASTER_KEY=GANTI_DENGAN_KEY_RANDOM_MINIMAL_32_KARAKTER

# Storage di luar document root Apache.
# SIMADA otomatis membuat subfolder Documents, Profile_Photos, dan Temp.
SIMADA_STORAGE_PATH=/srv/documents
SIMADA_MAX_UPLOAD_MB=20

# Smart OCR PDF Ubuntu
PDFTOTEXT_PATH=/usr/bin/pdftotext
PDFTOPPM_PATH=/usr/bin/pdftoppm
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANG=ind+eng
OCR_MAX_PAGES=30
OCR_DPI=200

# Preview DOC/DOCX/XLS/XLSX via LibreOffice headless
LIBREOFFICE_PATH=/usr/bin/libreoffice
